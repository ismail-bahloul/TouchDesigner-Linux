+/***********************************************************************
+ *              is_mutter_desktop
+ *
+ * Check if running under Mutter (GNOME) window manager.
+ * The Mutter workaround (Iconic -> Withdrawn -> Normal) breaks
+ * window creation on KDE/KWin. Only apply it on GNOME/Mutter.
+ */
+static BOOL is_mutter_desktop(void)
+{
+    const char *desktop = getenv("XDG_CURRENT_DESKTOP");
+    if (!desktop) return FALSE;
+    /* GNOME uses Mutter */
+    if (strstr(desktop, "GNOME") || strstr(desktop, "gnome") || strstr(desktop, "Mutter") || strstr(desktop, "mutter"))
+        return TRUE;
+    /* Also check for explicit Mutter WM detection */
+    if (X11DRV_HasWindowManager("Mutter (GNOME Mutter)"))
+        return TRUE;
+    return FALSE;
+}
