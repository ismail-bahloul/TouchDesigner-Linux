+/* Give the camera back when the graph is stopped. A V4L2 device only lets one
+ * file descriptor stream: as long as this one stays open after read() has started
+ * the stream, anything else that tries VIDIOC_S_FMT (another capture filter, another
+ * application) fails with EBUSY. */
+static NTSTATUS v4l_device_release( void *args )
+{
+    const struct destroy_params *params = args;
+    struct video_capture_device *device = get_device(params->device);
+
+    pthread_mutex_lock(&device->lock);
+    if (device->fd != -1)
+    {
+        TRACE("Releasing device %s.\n", device->path);
+        video_close(device->fd);
+        device->fd = -1;
+    }
+    device->started = FALSE; /* the format is applied again on the next start */
+    pthread_mutex_unlock(&device->lock);
+    return S_OK;
+}
+
 static NTSTATUS v4l_device_destroy( void *args )
 {
     const struct destroy_params *params = args;
@@ -656,6 +711,7 @@ const unixlib_entry_t __wine_unix_call_funcs[] =
