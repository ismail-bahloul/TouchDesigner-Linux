     return (struct video_capture_device *)(ULONG_PTR)dev;
 }
 
+static int device_open(struct video_capture_device *device)
+{
+    int fd;
+
+    TRACE("Opening device %s.\n", device->path);
+#ifdef O_CLOEXEC
+    if ((fd = video_open(device->path, O_RDWR | O_NONBLOCK | O_CLOEXEC)) == -1 && errno == EINVAL)
+#endif
+        fd = video_open(device->path, O_RDWR | O_NONBLOCK);
+    if (fd == -1)
+    {
+        WARN("Failed to open video device: %s\n", strerror(errno));
+        return -1;
+    }
+    fcntl(fd, F_SETFD, FD_CLOEXEC);  /* in case O_CLOEXEC isn't supported */
+    device->fd = fd;
+    return fd;
+}
+
+/* The device is closed when the graph is stopped (see v4l_device_release()),
+ * and reopened when it is needed again. */
+static int device_ioctl(struct video_capture_device *device, int request, void *arg)
+{
+    int ret, err;
+
+    pthread_mutex_lock(&device->lock);
+    if (device->fd == -1 && device_open(device) == -1)
+    {
+        pthread_mutex_unlock(&device->lock);
+        errno = ENODEV;
+        return -1;
+    }
+    ret = xioctl(device->fd, request, arg);
+    err = errno;
+    pthread_mutex_unlock(&device->lock);
+    errno = err;
+    return ret;
+}
+
