+            linuxHandleDesc.handle.fd = win32_handle_to_fd(linuxHandleDesc.handle.win32.handle, FALSE, NVCUDA_D3DKMT_RESOURCE);
             linuxHandleDesc.type = CU_EXTERNAL_MEMORY_HANDLE_TYPE_OPAQUE_FD;
