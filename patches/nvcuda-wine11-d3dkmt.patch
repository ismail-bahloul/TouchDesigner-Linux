             linuxHandleDesc.type = CU_EXTERNAL_MEMORY_HANDLE_TYPE_OPAQUE_FD;
+            break;
         default:
             break;
     }
@@ -4285,6 +4299,31 @@ static pthread_mutex_t semMutex = PTHREAD_MUTEX_INITIALIZER;
 static int semCounter = 0;
 static CUexternalSemaphore semList[4] = {0};
 
+/* The "keep only the last 4 imported semaphores" ring works around a game
+ * that leaks semaphores, but it destroys semaphores that are still in use by
+ * apps holding more than 4 at once (e.g. TouchDesigner with several NVIDIA
+ * TOPs), which deadlocks the CUDA stream. Opt-in with NVCUDA_SEMAPHORE_RING=1. */
+static BOOL semaphore_ring_enabled(void)
+{
+    static int enabled = -1;
+    if (enabled < 0)
+    {
+        const char *env = getenv("NVCUDA_SEMAPHORE_RING");
+        enabled = env && *env && *env != '0';
+    }
+    return enabled;
+}
+
+/* Forget a semaphore the app destroyed itself, so the ring never destroys it twice */
+static void semaphoreForget(CUexternalSemaphore extSem)
+{
+    int i;
+    pthread_mutex_lock(&semMutex);
+    for (i = 0; i < 4; i++)
+        if (semList[i] == extSem) semList[i] = NULL;
+    pthread_mutex_unlock(&semMutex);
+}
