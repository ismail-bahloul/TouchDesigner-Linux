+/* Wine >= 10.x / Proton 11 share GPU objects through D3DKMT objects held by
+ * the wineserver instead of Proton's old sharedgpures.sys device. The shared NT
+ * handle (or KMT global handle) resolves to a d3dkmt object that owns the host
+ * opaque fd, which we can fetch with wine_server_handle_to_fd().
+ *
+ * The request number depends on the exact Wine build (wine-staging adds
+ * requests), so it is a build-time default that can be overridden at runtime
+ * with NVCUDA_D3DKMT_OPEN_REQ. */
+#ifndef NVCUDA_D3DKMT_OPEN_REQ
+#define NVCUDA_D3DKMT_OPEN_REQ REQ_d3dkmt_object_open
+#endif
+
+static int d3dkmt_open_req(void)
+{
+    static int req = -1;
+    if (req < 0)
+    {
+        const char *env = getenv("NVCUDA_D3DKMT_OPEN_REQ");
+        req = env ? atoi(env) : NVCUDA_D3DKMT_OPEN_REQ;
+        TRACE("using d3dkmt_object_open request %d\n", req);
+    }
+    return req;
+}
+
+int get_d3dkmt_object_fd(HANDLE shared, BOOL kmt, unsigned int type)
+{
+    obj_handle_t handle = 0;
+    NTSTATUS status;
+    int unix_fd = -1;
+
+    SERVER_START_REQ( d3dkmt_object_open )
+    {
+        req->__header.req = d3dkmt_open_req();
+        req->type   = type;
+        req->global = kmt ? HandleToULong(shared) : 0;
+        req->handle = kmt ? 0 : wine_server_obj_handle(shared);
+        status = wine_server_call( req );
+        handle = reply->handle;
+    }
+    SERVER_END_REQ;
+
+    if (status || !handle)
+    {
+        WARN("d3dkmt_object_open failed for %p (kmt %d, type %u), status %#x\n", shared, kmt, type, (UINT)status);
+        return -1;
+    }
+
+    status = wine_server_handle_to_fd(wine_server_ptr_handle(handle), GENERIC_ALL, &unix_fd, NULL);
+    NtClose(wine_server_ptr_handle(handle));
+    if (status || unix_fd < 0)
+    {
+        WARN("no host fd for d3dkmt object %p (type %u), status %#x\n", shared, type, (UINT)status);
+        return -1;
+    }
+
+    TRACE("d3dkmt object %p (kmt %d, type %u) -> fd %d\n", shared, kmt, type, unix_fd);
+    return unix_fd;
+}
+
 #define IOCTL_SHARED_GPU_RESOURCE_GET_UNIX_RESOURCE CTL_CODE(FILE_DEVICE_VIDEO, 3, METHOD_BUFFERED, FILE_READ_ACCESS)
 #define IOCTL_SHARED_GPU_RESOURCE_GETKMT CTL_CODE(FILE_DEVICE_VIDEO, 2, METHOD_BUFFERED, FILE_READ_ACCESS)
 
