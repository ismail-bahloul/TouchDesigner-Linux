+/* Values of enum d3dkmt_type in the wineserver protocol */
+#define NVCUDA_D3DKMT_SYNC     5
+#define NVCUDA_D3DKMT_RESOURCE 6
+
+/* Linux libcuda only understands host fds: resolve a Windows shared handle
+ * through Wine's D3DKMT objects first, then fall back to Proton's legacy
+ * sharedgpures device for older runners. */
+static int win32_handle_to_fd(HANDLE handle, BOOL kmt, unsigned int type)
+{
+    int fd = get_d3dkmt_object_fd(handle, kmt, type);
+    if (fd >= 0) return fd;
+    if (kmt) handle = get_shared_resource_kmt_handle(handle);
+    return get_shared_resource_fd(handle);
+}
