#!/usr/bin/env python3
"""
TouchDesigner-Linux — Automated installer for TouchDesigner on Linux.

Usage:
    td-install                      Install (auto-detect graphical / headless)
    td-install --diagnose           System health check
    td-install --help               Full options
"""

import os
import sys

# Ensure the td_lib package is importable
SCRIPT_DIR = os.path.dirname(os.path.abspath(__file__))
if SCRIPT_DIR not in sys.path:
    sys.path.insert(0, SCRIPT_DIR)

from td_lib.cleanup import run_uninstall
from td_lib.cli import parse_args
from td_lib.diagnose import run_diagnose
from td_lib.install import run_install
from td_lib.update import run_update
from td_lib.utils import error, print_banner, setup_logging


def main():
    args = parse_args()

    # Auto-detect headless mode if no graphical session
    has_display = bool(os.environ.get("DISPLAY") or os.environ.get("WAYLAND_DISPLAY"))
    if not has_display and not args.headless:
        args.headless = True
        args.non_interactive = True

    # Auto-enable debug from environment
    if os.environ.get("DEBUG") in ("true", "1", "yes"):
        args.debug = True

    setup_logging(args.debug)

    if args.diagnose:
        run_diagnose()
        return

    if args.version:
        from td_lib import __version__

        print(f"td-install {__version__}")
        return

    # Show interactive menu if no action specified and not non-interactive
    if args.action is None:
        if args.non_interactive:
            args.action = "install"
        else:
            _show_menu(args)

    match args.action:
        case "install":
            run_install(args)
        case "update":
            run_update(args)
        case "uninstall":
            run_uninstall(args)
        case _:
            error("No action selected. Run with --help for usage.")
            sys.exit(1)


def _show_menu(args):
    """Show interactive main menu."""
    import shutil

    from td_lib.distro import detect_distro
    from td_lib.utils import Colors, print_banner, print_hr

    print_banner("1.4")

    distro = detect_distro()

    print(
        f"\n{Colors.dim}Detected: {distro.distro_name} / {distro.package_manager}{Colors.nc}\n"
    )
    print_hr()

    print(f"\n{Colors.bold}1{Colors.nc}  Install")
    print(
        f"{Colors.dim}     Run TouchDesigner on Linux (idempotent — safe to re-run){Colors.nc}"
    )
    print(f"\n{Colors.bold}2{Colors.nc}  Update")
    print(
        f"{Colors.dim}     Update launcher, Wine components, UI fixes and icons{Colors.nc}"
    )
    print(f"\n{Colors.bold}3{Colors.nc}  Uninstall")
    print(f"{Colors.dim}     Remove TouchDesigner versions or everything{Colors.nc}")
    print(f"\n{Colors.bold}0{Colors.nc}  Exit\n")

    try:
        choice = input("Select option [1]: ").strip() or "1"
    except (EOFError, KeyboardInterrupt):
        print()
        choice = "0"

    match choice:
        case "1":
            args.action = "install"
        case "2":
            args.action = "update"
        case "3":
            args.action = "uninstall"
        case "0":
            print("Exiting...")
            sys.exit(0)
        case _:
            args.action = "install"


if __name__ == "__main__":
    main()
