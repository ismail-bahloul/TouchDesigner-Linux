# cuda.dll — CUDA Runtime API for Wine
# PE/Unix split module: wraps nvcuda.dll calls in the higher-level
# CUDA Runtime API (cudaMalloc, cudaFree, cudaMemcpy, etc.)

@ stdcall cudaMalloc(ptr)
@ stdcall cudaFree(ptr)
@ stdcall cudaMemcpy(ptr)
@ stdcall cudaMemset(ptr)
@ stdcall cudaMallocHost(ptr)
@ stdcall cudaFreeHost(ptr)
@ stdcall cudaMallocArray(ptr)
@ stdcall cudaFreeArray(ptr)
@ stdcall cudaGetDevice(ptr)
@ stdcall cudaSetDevice(ptr)
@ stdcall cudaGetDeviceCount(ptr)
@ stdcall cudaGetDeviceProperties(ptr)
@ stdcall cudaChooseDevice(ptr)
@ stdcall cudaSetDeviceFlags(ptr)
@ stdcall cudaStreamCreate(ptr)
@ stdcall cudaStreamDestroy(ptr)
@ stdcall cudaStreamSynchronize(ptr)
@ stdcall cudaEventCreate(ptr)
@ stdcall cudaEventDestroy(ptr)
@ stdcall cudaEventRecord(ptr)
@ stdcall cudaEventSynchronize(ptr)
@ stdcall cudaEventElapsedTime(ptr)
@ stdcall cudaGetLastError(ptr)
@ stdcall cudaPeekAtLastError(ptr)
@ stdcall cudaGetErrorString(ptr)
@ stdcall cudaGetErrorName(ptr)
@ stdcall cudaRuntimeGetVersion(ptr)
@ stdcall cudaDriverGetVersion(ptr)
@ stdcall cudaConfigureCall(ptr)
@ stdcall cudaSetupArgument(ptr)
@ stdcall cudaLaunch(ptr)
@ stdcall cudaLaunchKernel(ptr)
@ stdcall cudaFuncSetAttribute(ptr)
@ stdcall cudaFuncSetCacheConfig(ptr)
@ stdcall __cudaRegisterFatBinary(ptr)
@ stdcall __cudaRegisterFunction(ptr)
@ stdcall __cudaUnregisterFatBinary(ptr)
@ stdcall __cudaPushCallConfiguration(ptr)
@ stdcall __cudaPopCallConfiguration(ptr)
@ stdcall cudaCreateSurfaceObject(ptr)
@ stdcall cudaDestroySurfaceObject(ptr)
@ stdcall cudaCreateTextureObject(ptr)
@ stdcall cudaDestroyTextureObject(ptr)
@ stdcall cudaGetSurfaceObjectResourceDesc(ptr)
@ stdcall cudaGetTextureObjectResourceDesc(ptr)
